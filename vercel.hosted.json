{
  "buildCommand": "",
  "outputDirectory": "hosted-out",
  "rewrites": [
    {
      "source": "/v1/:rest*",
      "destination": "/api/script?p=/v1/:rest*"
    },
    {
      "source": "/api/pages",
      "destination": "/api/hosted?p=/api/pages"
    },
    {
      "source": "/u/:id/api/:rest*",
      "destination": "/api/hosted?p=/u/:id/api/:rest*"
    },
    {
      "source": "/u/assets/:rest*",
      "destination": "/site/:rest*"
    },
    {
      "source": "/u/:id/",
      "destination": "/site/index.html"
    },
    {
      "source": "/u/:id/:rest*",
      "destination": "/site/:rest*"
    }
  ],
  "headers": [
    {
      "source": "/u/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/u/:id([a-z0-9-]+)",
      "destination": "/u/:id/",
      "permanent": false
    }
  ]
}
