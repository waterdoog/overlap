{
  "outputDirectory": "site",
  "buildCommand": "",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/llm/v1/:rest*",
      "destination": "/api/llm?p=/llm/v1/:rest*"
    },
    {
      "source": "/v1/:rest*",
      "destination": "/api/script?p=/v1/:rest*"
    },
    {
      "source": "/api/:rest*",
      "destination": "/api/page?p=/api/:rest*"
    }
  ]
}
